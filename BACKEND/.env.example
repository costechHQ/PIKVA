# Pikva backend configuration (SRS 26). Copy to .env and fill in.
# Never commit .env. Every value below is a placeholder.

# development | production. Production hides /docs and refuses a weak SECRET_KEY.
ENVIRONMENT=development

# PostgreSQL 16 through asyncpg.
DATABASE_URL=postgresql+asyncpg://pikva:CHANGE_ME@127.0.0.1:5432/pikva

# Signs JWTs and keys pickup-code hashes. At least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out and invalidates codes already issued today.
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30

# Log SQL statements (development only).
DATABASE_ECHO=false

# Redis 7 for rate limits and the alert-email cooldown. Database 15 is reserved for tests.
REDIS_URL=redis://127.0.0.1:6379/0

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Security alert emails through Resend (SRS 20). Leave both empty to log emails instead.
# EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Push notifications to admins' browsers for new security alerts. Leave all three
# empty to turn them off. Make the keys once with:
#   uv run python scripts/generate_vapid_keys.py
# Keep VAPID_PRIVATE_KEY secret; changing the pair stops existing subscriptions working.
# VAPID_SUBJECT is a mailto: or https: contact address, e.g. mailto:admin@yourschool.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# While a security alert stays unresolved, its push repeats this often (seconds; 0 turns
# reminders off) and for this long (minutes after the alert), so a forgotten one cannot ring all night.
PUSH_REPEAT_INTERVAL_SECONDS=60
PUSH_REPEAT_WINDOW_MINUTES=30

# The web app's public address, used for password reset links in emails.
WEB_APP_URL=http://localhost:3000

# Folder for uploaded pickup person photos (SRS 9.3), relative to where the
# server starts. Never served publicly; back it up in production.
PHOTO_STORAGE_DIR=storage/photos
